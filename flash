    echo "错误：找不到可执行的 busybox，请检查路径 $BUSYBOX"
    exit 1
fi

# 定义函数：获取网页源码
get_html_source() {
    local url="$1"
    local timeout="$2"
    local busybox_path="$3"
    local source=""

    # 优先尝试 wget
    source=$("$busybox_path" wget -q -T "$timeout" -O - -U "Mozilla/5.0" "$url" 2>/dev/null)
    if [ $? -eq 0 ] && [ -n "$source" ]; then
        echo "$source"
        return 0
    fi

    # wget 失败，尝试 curl
    echo "wget 失败，切换为 curl..."
    source=$("$busybox_path" curl -s -m "$timeout" -A "Mozilla/5.0" "$url" 2>/dev/null)
    if [ $? -eq 0 ] && [ -n "$source" ]; then
        echo "$source"
        return 0
    fi

    # 两种方式都失败
    return 1
}

# 主逻辑
echo "开始获取版本号...(推荐魔法)"

# 调用函数获取源码，并存储到变量
HTML_CONTENT=$(get_html_source "$URL" "$TIMEOUT" "$BUSYBOX")

